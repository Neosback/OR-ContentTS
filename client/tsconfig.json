{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "common",
    "components",
    "config",
    "custom",
    "game",
    "media",
    "network",
    "picogl",
    "render",
    "rs",
    "studio",
    "ui",
    "widgets",
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "scripts",
    "build",
    "node_modules"
  ]
}
