# Server configuration. Copy this file to `.env` in the repository root; values
# in `server/.env` override matching root values.
#
# The Studio client (Vite) reads only `client/.env*`: see client/.env.example.

# Optional shared WebRTC relay configuration. The client receives only the
# public URL and ICE configuration; server registration values remain private.
# WEBRTC_SIGNAL_URL=wss://relay.example.com
# WEBRTC_ICE_SERVERS=[{"urls":"stun:relay.example.com:3478"}]
# WEBRTC_WORLD_ID=my-world
# WEBRTC_WORLD_NAME=My World
# WEBRTC_WORLD_TOKEN=replace-with-registration-token

